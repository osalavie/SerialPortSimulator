<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SerialPortSimulator.TestClient</RootNamespace>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.6.4" />
    <PackageReference Include="System.IO.Ports" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SerialPortSimulator\Services\UiLanguage.cs" Link="Services\UiLanguage.cs" />
    <Compile Include="..\SerialPortSimulator\Services\UiLanguage.WinUI.cs" Link="Services\UiLanguage.WinUI.cs" />
    <Compile Include="..\SerialPortSimulator\Services\UiText.cs" Link="Services\UiText.cs" />
    <Compile Include="..\SerialPortSimulator\Services\TitleBarChrome.cs" Link="Services\TitleBarChrome.cs" />
    <Compile Include="..\SerialPortSimulator\Services\BoundedLogFile.cs" Link="Services\BoundedLogFile.cs" />
  </ItemGroup>
</Project>
