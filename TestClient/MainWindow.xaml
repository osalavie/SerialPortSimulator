<Window
    x:Class="SerialPortSimulator.TestClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        Padding="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock
                    Text="{StaticResource ClientTitle}"
                    FontSize="22"
                    FontWeight="SemiBold" />
                <TextBlock
                    Text="{StaticResource ClientIntro}"
                    TextWrapping="Wrap"
                    Opacity="0.7"
                    FontSize="12" />
            </StackPanel>
            <Button Grid.Column="1"
                    VerticalAlignment="Top"
                    Content="{StaticResource SwitchLanguage}"
                    Click="LanguageButton_Click" />
        </Grid>

        <Border
            Grid.Row="1"
            Margin="0,8,0,0"
            BorderBrush="#66808080"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="PortCombo"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="{StaticResource SelectPort}"
                        DropDownOpened="PortCombo_DropDownOpened"
                        SelectionChanged="PortCombo_SelectionChanged" />
                    <ComboBox
                        x:Name="BaudRateCombo"
                        Grid.Column="1"
                        IsEditable="True"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="{StaticResource BaudRate}"
                        SelectedIndex="3"
                        ToolTipService.ToolTip="{StaticResource BaudRate}">
                        <x:String>1200</x:String>
                        <x:String>2400</x:String>
                        <x:String>4800</x:String>
                        <x:String>9600</x:String>
                        <x:String>19200</x:String>
                        <x:String>38400</x:String>
                        <x:String>57600</x:String>
                        <x:String>115200</x:String>
                        <x:String>230400</x:String>
                        <x:String>460800</x:String>
                        <x:String>921600</x:String>
                    </ComboBox>
                    <ComboBox
                        x:Name="DataBitsCombo"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="3"
                        ToolTipService.ToolTip="{StaticResource DataBits}">
                        <x:String>5</x:String>
                        <x:String>6</x:String>
                        <x:String>7</x:String>
                        <x:String>8</x:String>
                    </ComboBox>
                    <ComboBox
                        x:Name="ParityCombo"
                        Grid.Column="3"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0"
                        ToolTipService.ToolTip="{StaticResource Parity}">
                        <ComboBoxItem Content="{StaticResource None}" />
                        <ComboBoxItem Content="{StaticResource Odd}" />
                        <ComboBoxItem Content="{StaticResource Even}" />
                        <ComboBoxItem Content="Mark" />
                        <ComboBoxItem Content="Space" />
                    </ComboBox>
                    <ComboBox
                        x:Name="StopBitsCombo"
                        Grid.Column="4"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0"
                        ToolTipService.ToolTip="{StaticResource StopBits}">
                        <x:String>1</x:String>
                        <x:String>1.5</x:String>
                        <x:String>2</x:String>
                    </ComboBox>
                    <Button
                        x:Name="OpenButton"
                        Grid.Column="5"
                        Content="{StaticResource OpenPort}"
                        Click="OpenButton_Click" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <CheckBox x:Name="DtrCheck" Content="DTR" />
                    <CheckBox
                        x:Name="RtsCheck"
                        Content="RTS"
                        ToolTipService.ToolTip="{StaticResource RtsHelp}" />
                    <CheckBox
                        x:Name="RtsCtsCheck"
                        Content="{StaticResource FlowControl}"
                        Checked="RtsCtsCheck_Changed"
                        Unchecked="RtsCtsCheck_Changed"
                        ToolTipService.ToolTip="{StaticResource FlowControlHelp}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border
            Grid.Row="2"
            Margin="0,8,0,0"
            BorderBrush="#66808080"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <TextBlock
                        Text="{StaticResource Traffic}"
                        FontSize="16"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10">
                        <CheckBox
                            x:Name="HexCheck"
                            Content="{StaticResource Hex}"
                            Checked="DisplayOption_Changed"
                            Unchecked="DisplayOption_Changed" />
                        <CheckBox
                            x:Name="TimestampCheck"
                            Content="{StaticResource Timestamp}"
                            IsChecked="True"
                            Checked="DisplayOption_Changed"
                            Unchecked="DisplayOption_Changed" />
                        <Button
                            Content="{StaticResource ClearLog}"
                            Click="ClearButton_Click" />
                    </StackPanel>
                </Grid>
                <TextBox
                    x:Name="LogBox"
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    MinHeight="180"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    FontFamily="Consolas" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,8,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="SendBox"
                Grid.Column="0"
                PlaceholderText="{StaticResource SendHint}"
                KeyDown="SendBox_KeyDown" />
            <CheckBox
                x:Name="NewLineCheck"
                Grid.Column="1"
                Content="CRLF"
                IsChecked="True"
                VerticalAlignment="Center" />
            <Button
                x:Name="SendButton"
                Grid.Column="2"
                Content="{StaticResource Send}"
                Click="SendButton_Click" />
        </Grid>

        <Border
            Grid.Row="4"
            Margin="0,8,0,0"
            Padding="10,6"
            BorderBrush="#66808080"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <TextBlock
                    x:Name="StatusText"
                    Text="{StaticResource Disconnected}"
                    Opacity="0.8"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="StatsText"
                    HorizontalAlignment="Right"
                    Opacity="0.7"
                    FontFamily="Consolas" />
            </Grid>
        </Border>
    </Grid>
</Window>
