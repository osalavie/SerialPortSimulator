<Window
    x:Class="SerialPortSimulator.TestClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="串口模拟器 · 业务测试端">
    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        Padding="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock
                Text="串口模拟器 · 业务测试端"
                FontSize="22"
                FontWeight="SemiBold" />
            <TextBlock
                Text="通过 COM 口连接模拟设备，验证串口参数与收发行为"
                Opacity="0.7"
                FontSize="12" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,8,0,0"
            BorderBrush="#66808080"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="PortCombo"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="选择串口设备"
                        DropDownOpened="PortCombo_DropDownOpened"
                        SelectionChanged="PortCombo_SelectionChanged" />
                    <ComboBox
                        x:Name="BaudRateCombo"
                        Grid.Column="1"
                        IsEditable="True"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="波特率"
                        SelectedIndex="3"
                        ToolTipService.ToolTip="波特率">
                        <x:String>1200</x:String>
                        <x:String>2400</x:String>
                        <x:String>4800</x:String>
                        <x:String>9600</x:String>
                        <x:String>19200</x:String>
                        <x:String>38400</x:String>
                        <x:String>57600</x:String>
                        <x:String>115200</x:String>
                        <x:String>230400</x:String>
                        <x:String>460800</x:String>
                        <x:String>921600</x:String>
                    </ComboBox>
                    <ComboBox
                        x:Name="DataBitsCombo"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="3"
                        ToolTipService.ToolTip="数据位">
                        <x:String>5</x:String>
                        <x:String>6</x:String>
                        <x:String>7</x:String>
                        <x:String>8</x:String>
                    </ComboBox>
                    <ComboBox
                        x:Name="ParityCombo"
                        Grid.Column="3"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0"
                        ToolTipService.ToolTip="校验位">
                        <x:String>无</x:String>
                        <x:String>奇校验</x:String>
                        <x:String>偶校验</x:String>
                        <x:String>Mark</x:String>
                        <x:String>Space</x:String>
                    </ComboBox>
                    <ComboBox
                        x:Name="StopBitsCombo"
                        Grid.Column="4"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0"
                        ToolTipService.ToolTip="停止位">
                        <x:String>1</x:String>
                        <x:String>1.5</x:String>
                        <x:String>2</x:String>
                    </ComboBox>
                    <Button
                        x:Name="OpenButton"
                        Grid.Column="5"
                        Content="打开端口"
                        Click="OpenButton_Click" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <CheckBox x:Name="DtrCheck" Content="DTR" />
                    <CheckBox
                        x:Name="RtsCheck"
                        Content="RTS"
                        ToolTipService.ToolTip="RTS/CTS 流控开启时由串口栈自动控制" />
                    <CheckBox
                        x:Name="RtsCtsCheck"
                        Content="RTS/CTS 流控"
                        Checked="RtsCtsCheck_Changed"
                        Unchecked="RtsCtsCheck_Changed"
                        ToolTipService.ToolTip="开启后由串口栈自动控制 RTS，CTS 由模拟器端控制" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border
            Grid.Row="2"
            Margin="0,8,0,0"
            BorderBrush="#66808080"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <TextBlock
                        Text="收发数据"
                        FontSize="16"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10">
                        <CheckBox
                            x:Name="HexCheck"
                            Content="十六进制"
                            Checked="DisplayOption_Changed"
                            Unchecked="DisplayOption_Changed" />
                        <CheckBox
                            x:Name="TimestampCheck"
                            Content="时间戳"
                            IsChecked="True"
                            Checked="DisplayOption_Changed"
                            Unchecked="DisplayOption_Changed" />
                        <Button
                            Content="清空记录"
                            Click="ClearButton_Click" />
                    </StackPanel>
                </Grid>
                <TextBox
                    x:Name="LogBox"
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    MinHeight="180"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    FontFamily="Consolas" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,8,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="SendBox"
                Grid.Column="0"
                PlaceholderText="输入内容，Ctrl+Enter 发送"
                KeyDown="SendBox_KeyDown" />
            <CheckBox
                x:Name="NewLineCheck"
                Grid.Column="1"
                Content="CRLF"
                IsChecked="True"
                VerticalAlignment="Center" />
            <Button
                x:Name="SendButton"
                Grid.Column="2"
                Content="发送"
                Click="SendButton_Click" />
        </Grid>

        <Border
            Grid.Row="4"
            Margin="0,8,0,0"
            Padding="10,6"
            BorderBrush="#66808080"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <TextBlock
                    x:Name="StatusText"
                    Text="未连接"
                    Opacity="0.8"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="StatsText"
                    HorizontalAlignment="Right"
                    Opacity="0.7"
                    FontFamily="Consolas" />
            </Grid>
        </Border>
    </Grid>
</Window>
