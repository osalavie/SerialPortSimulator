<Window
    x:Class="SerialPortSimulator.TestClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:SerialPortSimulator.Services">
    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarRoot" Grid.Row="0" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="TitleBarDragRegion" Grid.Column="0" Background="Transparent">
                <TextBlock
                    ui:UiText.Key="ClientTitle"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12" />
            </Grid>
            <Button
                x:Name="LanguageButton"
                Grid.Column="1"
                Width="40"
                Height="32"
                Margin="0,0,4,0"
                Padding="0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="LanguageButton_Click"
                ToolTipService.Placement="Bottom"
                ui:UiText.Tip="SwitchLanguage">
                <FontIcon Glyph="&#xE774;" FontSize="14" />
            </Button>
        </Grid>

        <TextBlock
            Grid.Row="1"
            ui:UiText.Key="ClientIntro"
            Margin="20,8,20,0"
            TextWrapping="Wrap"
            Opacity="0.7"
            FontSize="12" />

        <Border
            Grid.Row="2"
            Margin="20,8,20,0"
            BorderBrush="#66808080"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="PortCombo"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        ui:UiText.Key="SelectPort"
                        DropDownOpened="PortCombo_DropDownOpened"
                        SelectionChanged="PortCombo_SelectionChanged" />
                    <ComboBox
                        x:Name="BaudRateCombo"
                        Grid.Column="1"
                        IsEditable="True"
                        HorizontalAlignment="Stretch"
                        ui:UiText.Key="BaudRate"
                        SelectedIndex="3"
                        ui:UiText.Tip="BaudRate">
                        <x:String>1200</x:String>
                        <x:String>2400</x:String>
                        <x:String>4800</x:String>
                        <x:String>9600</x:String>
                        <x:String>19200</x:String>
                        <x:String>38400</x:String>
                        <x:String>57600</x:String>
                        <x:String>115200</x:String>
                        <x:String>230400</x:String>
                        <x:String>460800</x:String>
                        <x:String>921600</x:String>
                    </ComboBox>
                    <ComboBox
                        x:Name="DataBitsCombo"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="3"
                        ui:UiText.Tip="DataBits">
                        <x:String>5</x:String>
                        <x:String>6</x:String>
                        <x:String>7</x:String>
                        <x:String>8</x:String>
                    </ComboBox>
                    <ComboBox
                        x:Name="ParityCombo"
                        Grid.Column="3"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0"
                        ui:UiText.Tip="Parity">
                        <ComboBoxItem ui:UiText.Key="None" />
                        <ComboBoxItem ui:UiText.Key="Odd" />
                        <ComboBoxItem ui:UiText.Key="Even" />
                        <ComboBoxItem Content="Mark" />
                        <ComboBoxItem Content="Space" />
                    </ComboBox>
                    <ComboBox
                        x:Name="StopBitsCombo"
                        Grid.Column="4"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0"
                        ui:UiText.Tip="StopBits">
                        <x:String>1</x:String>
                        <x:String>1.5</x:String>
                        <x:String>2</x:String>
                    </ComboBox>
                    <Button
                        x:Name="OpenButton"
                        Grid.Column="5"
                        ui:UiText.Key="OpenPort"
                        Click="OpenButton_Click" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <CheckBox x:Name="DtrCheck" Content="DTR" />
                    <CheckBox
                        x:Name="RtsCheck"
                        Content="RTS"
                        ui:UiText.Tip="RtsHelp" />
                    <CheckBox
                        x:Name="RtsCtsCheck"
                        ui:UiText.Key="FlowControl"
                        Checked="RtsCtsCheck_Changed"
                        Unchecked="RtsCtsCheck_Changed"
                        ui:UiText.Tip="FlowControlHelp" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border
            Grid.Row="3"
            Margin="20,8,20,0"
            BorderBrush="#66808080"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <TextBlock
                        ui:UiText.Key="Traffic"
                        FontSize="16"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10">
                        <CheckBox
                            x:Name="HexCheck"
                            ui:UiText.Key="Hex"
                            Checked="DisplayOption_Changed"
                            Unchecked="DisplayOption_Changed" />
                        <CheckBox
                            x:Name="TimestampCheck"
                            ui:UiText.Key="Timestamp"
                            IsChecked="True"
                            Checked="DisplayOption_Changed"
                            Unchecked="DisplayOption_Changed" />
                        <Button
                            ui:UiText.Key="ClearLog"
                            Click="ClearButton_Click" />
                    </StackPanel>
                </Grid>
                <TextBox
                    x:Name="LogBox"
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    MinHeight="180"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    FontFamily="Consolas" />
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="20,8,20,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="SendBox"
                Grid.Column="0"
                ui:UiText.Key="SendHint"
                KeyDown="SendBox_KeyDown" />
            <CheckBox
                x:Name="NewLineCheck"
                Grid.Column="1"
                Content="CRLF"
                IsChecked="True"
                VerticalAlignment="Center" />
            <Button
                x:Name="SendButton"
                Grid.Column="2"
                ui:UiText.Key="Send"
                Click="SendButton_Click" />
        </Grid>

        <Border
            Grid.Row="5"
            Margin="20,8,20,16"
            Padding="10,6"
            BorderBrush="#66808080"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <TextBlock
                    x:Name="StatusText"
                    ui:UiText.Key="Disconnected"
                    Opacity="0.8"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="StatsText"
                    HorizontalAlignment="Right"
                    Opacity="0.7"
                    FontFamily="Consolas" />
            </Grid>
        </Border>
    </Grid>
</Window>
