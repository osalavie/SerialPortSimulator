<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SerialPortSimulator</RootNamespace>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="Assets\AppIcon.ico" />
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Remove="Assets\AppIcon.svg" />
    <None Include="Assets\AppIcon.svg" />
  </ItemGroup>
  <Target Name="CopyAppIconOnPublish" AfterTargets="Publish">
    <Copy SourceFiles="Assets\AppIcon.ico" DestinationFolder="$(PublishDir)Assets" />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.6.4" />
    <PackageReference Include="System.IO.Ports" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DeviceManager\SerialPortSimulator.DeviceManager.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>
  <Target Name="CopyDeviceManagerHelper"
          AfterTargets="Build"
          Condition="Exists('..\DeviceManager\bin\$(Platform)\$(Configuration)\$(TargetFramework)\SerialPortSimulator.DeviceManager.exe')">
    <ItemGroup>
      <_DeviceManagerFiles Include="..\DeviceManager\bin\$(Platform)\$(Configuration)\$(TargetFramework)\SerialPortSimulator.DeviceManager.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeviceManagerFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
