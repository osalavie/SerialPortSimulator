<Window
    x:Class="SerialPortSimulator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:SerialPortSimulator.Services">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarRoot" Grid.Row="0" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="TitleBarDragRegion" Grid.Column="0" Background="Transparent">
                <TextBlock
                    ui:UiText.Key="SimulatorTitle"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12" />
            </Grid>
            <TextBlock
                x:Name="TitleDeviceText"
                Grid.ColumnSpan="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Consolas"
                FontSize="12"
                Opacity="0.6"
                IsHitTestVisible="False" />
            <Button
                x:Name="LanguageButton"
                Grid.Column="1"
                Width="40"
                Height="32"
                Margin="0,0,4,0"
                Padding="0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="LanguageButton_Click"
                ToolTipService.Placement="Bottom"
                ui:UiText.Tip="SwitchLanguage">
                <FontIcon Glyph="&#xE774;" FontSize="14" />
            </Button>
        </Grid>

        <TabView
            x:Name="DeviceTabs"
            Grid.Row="1"
            Margin="18,4,18,10"
            IsAddTabButtonVisible="False"
            CanReorderTabs="False"
            TabWidthMode="SizeToContent"
            TabCloseRequested="DeviceTabs_TabCloseRequested"
            SelectionChanged="DeviceTabs_SelectionChanged">
            <TabView.TabStripFooter>
                <Button
                    x:Name="CreateDeviceButton"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Click="CreateDeviceButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock ui:UiText.Key="AddDevice" />
                    </StackPanel>
                </Button>
            </TabView.TabStripFooter>
        </TabView>

        <Border
            Grid.Row="2"
            Margin="24,0,24,16"
            Padding="12,8"
            BorderBrush="#66808080"
            BorderThickness="1"
            CornerRadius="6">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />
                <TextBlock
                    x:Name="ResourceText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    Opacity="0.6" />
            </Grid>
        </Border>
    </Grid>
</Window>
