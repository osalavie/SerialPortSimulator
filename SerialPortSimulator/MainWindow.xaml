<Window
    x:Class="SerialPortSimulator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SerialPortSimulator.Controls"
    xmlns:ui="using:SerialPortSimulator.Services">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarRoot" Grid.Row="0" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="TitleBarDragRegion" Grid.Column="0" Background="Transparent">
                <TextBlock
                    ui:UiText.Key="SimulatorTitle"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12" />
            </Grid>
            <Button
                x:Name="LanguageButton"
                Grid.Column="1"
                Width="40"
                Height="32"
                Margin="0,0,4,0"
                Padding="0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="LanguageButton_Click"
                ToolTipService.Placement="Bottom"
                ui:UiText.Tip="SwitchLanguage">
                <FontIcon Glyph="&#xE774;" FontSize="14" />
            </Button>
        </Grid>

        <TextBlock
            Grid.Row="1"
            ui:UiText.Key="SimulatorIntro"
            Margin="24,10,24,6"
            TextWrapping="Wrap"
            Opacity="0.7" />

        <TabView
            Grid.Row="2"
            Margin="18,0,18,10"
            IsAddTabButtonVisible="False"
            TabWidthMode="Equal">
            <TabViewItem ui:UiText.Key="VirtualDevice" IsClosable="False">
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Center">
                    <controls:FlowPanel
                        Margin="4,14,4,20"
                        MaxWidth="980"
                        HorizontalAlignment="Center"
                        MinimumItemWidth="360"
                        HorizontalSpacing="16"
                        VerticalSpacing="16">
                        <Border
                            controls:FlowPanel.Span="2"
                            BorderBrush="#66808080"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                            <StackPanel Spacing="14">
                                <TextBlock ui:UiText.Key="Connection" FontSize="18" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        x:Name="DeviceCombo"
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        ui:UiText.Key="SelectVirtualPort"
                                        SelectionChanged="DeviceCombo_SelectionChanged" />
                                    <Button
                                        x:Name="RefreshButton"
                                        Grid.Column="1"
                                        ui:UiText.Key="Refresh"
                                        Click="RefreshButton_Click" />
                                    <Button
                                        x:Name="ConnectButton"
                                        Grid.Column="2"
                                        ui:UiText.Key="OpenControlLink"
                                        Click="ConnectButton_Click" />
                                </Grid>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock ui:UiText.Key="ClientPort" Opacity="0.7" FontSize="12" />
                                        <TextBlock x:Name="PortText" ui:UiText.Key="NoneSelected" FontFamily="Consolas" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock ui:UiText.Key="DeviceId" Opacity="0.7" FontSize="12" />
                                        <TextBlock
                                            x:Name="DeviceIdText"
                                            ui:UiText.Key="NoneSelected"
                                            FontFamily="Consolas"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    ui:UiText.Key="ControlLinkHelp"
                                    Opacity="0.7"
                                    FontSize="12"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#66808080" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock ui:UiText.Key="PortSettings" FontSize="18" FontWeight="SemiBold" />
                                <StackPanel x:Name="SerialParameterPanel" Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="5">
                                            <TextBlock ui:UiText.Key="BaudRate" />
                                            <ComboBox
                                                x:Name="BaudRateCombo"
                                                IsEditable="True"
                                                HorizontalAlignment="Stretch"
                                                SelectedIndex="3">
                                                <x:String>1200</x:String>
                                                <x:String>2400</x:String>
                                                <x:String>4800</x:String>
                                                <x:String>9600</x:String>
                                                <x:String>19200</x:String>
                                                <x:String>38400</x:String>
                                                <x:String>57600</x:String>
                                                <x:String>115200</x:String>
                                                <x:String>230400</x:String>
                                                <x:String>460800</x:String>
                                                <x:String>921600</x:String>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <TextBlock ui:UiText.Key="DataBits" />
                                            <ComboBox x:Name="DataBitsCombo" HorizontalAlignment="Stretch" SelectedIndex="3">
                                                <x:String>5</x:String>
                                                <x:String>6</x:String>
                                                <x:String>7</x:String>
                                                <x:String>8</x:String>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="5">
                                            <TextBlock ui:UiText.Key="Parity" />
                                            <ComboBox x:Name="ParityCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                                                <ComboBoxItem ui:UiText.Key="None" />
                                                <ComboBoxItem ui:UiText.Key="Odd" />
                                                <ComboBoxItem ui:UiText.Key="Even" />
                                                <ComboBoxItem Content="Mark" />
                                                <ComboBoxItem Content="Space" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Spacing="5">
                                            <TextBlock ui:UiText.Key="StopBits" />
                                            <ComboBox x:Name="StopBitsCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                                                <x:String>1</x:String>
                                                <x:String>1.5</x:String>
                                                <x:String>2</x:String>
                                            </ComboBox>
                                        </StackPanel>
                                        <Button
                                            x:Name="ApplySerialParametersButton"
                                            Grid.Column="4"
                                            ui:UiText.Key="ApplySettings"
                                            Click="ApplySerialParametersButton_Click"
                                            VerticalAlignment="Bottom" />
                                    </Grid>
                                    <CheckBox x:Name="LimitToBaudRateCheck"
                                              ui:UiText.Key="LimitBaudRate"
                                              IsEnabled="False" />
                                    <CheckBox
                                        x:Name="CtsOnCheck"
                                        ui:UiText.Key="AllowCts"
                                        IsEnabled="False"
                                        Checked="CtsOnCheck_Changed"
                                        Unchecked="CtsOnCheck_Changed" />
                                    <TextBlock
                                        x:Name="BusinessLineText"
                                        ui:UiText.Key="ClientLinesHelp"
                                        Opacity="0.7"
                                        FontSize="12"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="SerialParameterStatusText"
                                        ui:UiText.Key="SelectDeviceHelp"
                                        Opacity="0.7"
                                        FontSize="12"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#66808080" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock ui:UiText.Key="ManageDevices" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock
                                    ui:UiText.Key="AdminHelp"
                                    Opacity="0.7"
                                    FontSize="12"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button
                                        x:Name="CreateDeviceButton"
                                        ui:UiText.Key="AddDevice"
                                        Click="CreateDeviceButton_Click" />
                                    <Button
                                        x:Name="UpdateDriverButton"
                                        ui:UiText.Key="UpdateDriver"
                                        Click="UpdateDriverButton_Click" />
                                    <Button
                                        x:Name="RemoveDeviceButton"
                                        ui:UiText.Key="RemoveDevice"
                                        Click="RemoveDeviceButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </controls:FlowPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem ui:UiText.Key="SendReceive" IsClosable="False">
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Center">
                    <controls:FlowPanel
                        Margin="4,14,4,20"
                        MaxWidth="980"
                        HorizontalAlignment="Center"
                        MinimumItemWidth="360"
                        HorizontalSpacing="16"
                        VerticalSpacing="16">
                        <Border BorderBrush="#66808080" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <TextBlock ui:UiText.Key="SimulatedData" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="InjectionTargetText"
                                        ui:UiText.Key="NoTarget"
                                        HorizontalAlignment="Right"
                                        Opacity="0.7"
                                        FontFamily="Consolas" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="5">
                                        <TextBlock ui:UiText.Key="DataType" />
                                        <ComboBox x:Name="ModeCombo" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="ModeCombo_SelectionChanged">
                                            <ComboBoxItem ui:UiText.Key="Counter" />
                                            <ComboBoxItem ui:UiText.Key="SineWave" />
                                            <ComboBoxItem ui:UiText.Key="Random" />
                                            <ComboBoxItem ui:UiText.Key="FixedText" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <TextBlock ui:UiText.Key="Interval" />
                                        <TextBox x:Name="IntervalBox" Text="1000" InputScope="Number" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="5">
                                    <TextBlock x:Name="TemplateLabel" ui:UiText.Key="MessageFormat" />
                                    <TextBox
                                        x:Name="TemplateBox"
                                        Text="{}{timestamp},{counter},{value}"
                                        ui:UiText.Key="EnterMessageFormat"
                                        AcceptsReturn="True"
                                        Height="72"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="TemplateHint"
                                        ui:UiText.Key="TemplateHelp"
                                        TextWrapping="Wrap"
                                        Opacity="0.7"
                                        FontSize="12" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock ui:UiText.Key="LineEnding" VerticalAlignment="Center" />
                                    <ComboBox x:Name="LineEndingCombo" Width="145" SelectedIndex="1">
                                        <ComboBoxItem ui:UiText.Key="None" />
                                        <ComboBoxItem Content="CRLF (\r\n)" />
                                        <ComboBoxItem Content="LF (\n)" />
                                        <ComboBoxItem Content="CR (\r)" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="StartButton" ui:UiText.Key="StartSending" Click="StartButton_Click" IsEnabled="False" />
                                    <Button x:Name="StopButton" ui:UiText.Key="Stop" Click="StopButton_Click" IsEnabled="False" />
                                    <Button x:Name="SendOnceButton" ui:UiText.Key="SendOnce" Click="SendOnceButton_Click" IsEnabled="False" />
                                    <Button x:Name="ResetButton" ui:UiText.Key="ResetCount" Click="ResetButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#66808080" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock ui:UiText.Key="ReplyRules" FontSize="18" FontWeight="SemiBold" />
                                <TextBox
                                    x:Name="RuleBox"
                                    Text="PING=PONG"
                                    AcceptsReturn="True"
                                    TextWrapping="NoWrap"
                                    Height="92"
                                    FontFamily="Consolas"
                                    ui:UiText.Key="ReplyRuleHint" />
                                <TextBlock
                                    ui:UiText.Key="ReplyRuleHelp"
                                    Opacity="0.7"
                                    FontSize="12"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border
                            controls:FlowPanel.Span="2"
                            BorderBrush="#66808080"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <TextBlock ui:UiText.Key="Traffic" FontSize="18" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                        <CheckBox x:Name="ShowLogTimestampCheck"
                                                  ui:UiText.Key="ShowTime"
                                                  IsChecked="True"
                                                  Checked="ShowLogTimestampCheck_Changed"
                                                  Unchecked="ShowLogTimestampCheck_Changed" />
                                        <Button ui:UiText.Key="ClearLog" Click="ClearButton_Click" />
                                    </StackPanel>
                                </Grid>
                                <TextBox
                                    x:Name="LogBox"
                                    IsReadOnly="True"
                                    AcceptsReturn="True"
                                    TextWrapping="NoWrap"
                                    Height="180"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    FontFamily="Consolas" />
                            </StackPanel>
                        </Border>
                    </controls:FlowPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>

        <Border
            Grid.Row="3"
            Margin="24,0,24,16"
            Padding="12,8"
            BorderBrush="#66808080"
            BorderThickness="1"
            CornerRadius="6">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" ui:UiText.Key="Disconnected" Opacity="0.8" TextWrapping="Wrap" />
                <TextBlock
                    x:Name="ResourceText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    Opacity="0.6" />
            </Grid>
        </Border>
    </Grid>
</Window>
