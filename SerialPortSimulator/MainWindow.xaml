<Window
    x:Class="SerialPortSimulator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SerialPortSimulator.Controls">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,18,24,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="{StaticResource SimulatorTitle}" FontSize="27" FontWeight="SemiBold" />
                <TextBlock
                    Text="{StaticResource SimulatorIntro}"
                    TextWrapping="Wrap"
                    Opacity="0.7" />
            </StackPanel>
            <Button Grid.Column="1"
                    VerticalAlignment="Top"
                    Content="{StaticResource SwitchLanguage}"
                    Click="LanguageButton_Click" />
        </Grid>

        <TabView
            Grid.Row="1"
            Margin="18,0,18,10"
            IsAddTabButtonVisible="False"
            TabWidthMode="Equal">
            <TabViewItem Header="{StaticResource VirtualDevice}" IsClosable="False">
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Center">
                    <controls:FlowPanel
                        Margin="4,14,4,20"
                        MaxWidth="980"
                        HorizontalAlignment="Center"
                        MinimumItemWidth="360"
                        HorizontalSpacing="16"
                        VerticalSpacing="16">
                        <Border
                            controls:FlowPanel.Span="2"
                            BorderBrush="#66808080"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                            <StackPanel Spacing="14">
                                <TextBlock Text="{StaticResource Connection}" FontSize="18" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        x:Name="DeviceCombo"
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        PlaceholderText="{StaticResource SelectVirtualPort}"
                                        SelectionChanged="DeviceCombo_SelectionChanged" />
                                    <Button
                                        x:Name="RefreshButton"
                                        Grid.Column="1"
                                        Content="{StaticResource Refresh}"
                                        Click="RefreshButton_Click" />
                                    <Button
                                        x:Name="ConnectButton"
                                        Grid.Column="2"
                                        Content="{StaticResource OpenControlLink}"
                                        Click="ConnectButton_Click" />
                                </Grid>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{StaticResource ClientPort}" Opacity="0.7" FontSize="12" />
                                        <TextBlock x:Name="PortText" Text="{StaticResource NoneSelected}" FontFamily="Consolas" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{StaticResource DeviceId}" Opacity="0.7" FontSize="12" />
                                        <TextBlock
                                            x:Name="DeviceIdText"
                                            Text="{StaticResource NoneSelected}"
                                            FontFamily="Consolas"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="3">
                                        <TextBlock Text="{StaticResource Protocol}" Opacity="0.7" FontSize="12" />
                                        <TextBlock x:Name="ProtocolText" Text="{StaticResource NotRead}" FontFamily="Consolas" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    Text="{StaticResource ControlLinkHelp}"
                                    Opacity="0.7"
                                    FontSize="12"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#66808080" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{StaticResource PortSettings}" FontSize="18" FontWeight="SemiBold" />
                                <StackPanel x:Name="SerialParameterPanel" Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{StaticResource BaudRate}" />
                                            <ComboBox
                                                x:Name="BaudRateCombo"
                                                IsEditable="True"
                                                HorizontalAlignment="Stretch"
                                                SelectedIndex="3">
                                                <x:String>1200</x:String>
                                                <x:String>2400</x:String>
                                                <x:String>4800</x:String>
                                                <x:String>9600</x:String>
                                                <x:String>19200</x:String>
                                                <x:String>38400</x:String>
                                                <x:String>57600</x:String>
                                                <x:String>115200</x:String>
                                                <x:String>230400</x:String>
                                                <x:String>460800</x:String>
                                                <x:String>921600</x:String>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <TextBlock Text="{StaticResource DataBits}" />
                                            <ComboBox x:Name="DataBitsCombo" HorizontalAlignment="Stretch" SelectedIndex="3">
                                                <x:String>5</x:String>
                                                <x:String>6</x:String>
                                                <x:String>7</x:String>
                                                <x:String>8</x:String>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="5">
                                            <TextBlock Text="{StaticResource Parity}" />
                                            <ComboBox x:Name="ParityCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                                                <ComboBoxItem Content="{StaticResource None}" />
                                                <ComboBoxItem Content="{StaticResource Odd}" />
                                                <ComboBoxItem Content="{StaticResource Even}" />
                                                <ComboBoxItem Content="Mark" />
                                                <ComboBoxItem Content="Space" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Spacing="5">
                                            <TextBlock Text="{StaticResource StopBits}" />
                                            <ComboBox x:Name="StopBitsCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                                                <x:String>1</x:String>
                                                <x:String>1.5</x:String>
                                                <x:String>2</x:String>
                                            </ComboBox>
                                        </StackPanel>
                                        <Button
                                            x:Name="ApplySerialParametersButton"
                                            Grid.Column="4"
                                            Content="{StaticResource ApplySettings}"
                                            Click="ApplySerialParametersButton_Click"
                                            VerticalAlignment="Bottom" />
                                    </Grid>
                                    <CheckBox x:Name="LimitToBaudRateCheck"
                                              Content="{StaticResource LimitBaudRate}"
                                              IsEnabled="False" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <CheckBox x:Name="CtsOnCheck" Content="{StaticResource AllowCts}" IsEnabled="False" />
                                        <Button x:Name="ApplyCtsButton" Content="{StaticResource ApplyCts}" Click="ApplyCtsButton_Click" IsEnabled="False" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="BusinessLineText"
                                        Text="{StaticResource ClientLinesHelp}"
                                        Opacity="0.7"
                                        FontSize="12"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="SerialParameterStatusText"
                                        Text="{StaticResource SelectDeviceHelp}"
                                        Opacity="0.7"
                                        FontSize="12"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#66808080" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{StaticResource ManageDevices}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{StaticResource AdminHelp}"
                                    Opacity="0.7"
                                    FontSize="12"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button
                                        x:Name="CreateDeviceButton"
                                        Content="{StaticResource AddDevice}"
                                        Click="CreateDeviceButton_Click" />
                                    <Button
                                        x:Name="UpdateDriverButton"
                                        Content="{StaticResource UpdateDriver}"
                                        Click="UpdateDriverButton_Click" />
                                    <Button
                                        x:Name="RemoveDeviceButton"
                                        Content="{StaticResource RemoveDevice}"
                                        Click="RemoveDeviceButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </controls:FlowPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="{StaticResource SendReceive}" IsClosable="False">
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Center">
                    <controls:FlowPanel
                        Margin="4,14,4,20"
                        MaxWidth="980"
                        HorizontalAlignment="Center"
                        MinimumItemWidth="360"
                        HorizontalSpacing="16"
                        VerticalSpacing="16">
                        <Border BorderBrush="#66808080" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <TextBlock Text="{StaticResource SimulatedData}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="InjectionTargetText"
                                        Text="{StaticResource NoTarget}"
                                        HorizontalAlignment="Right"
                                        Opacity="0.7"
                                        FontFamily="Consolas" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{StaticResource DataType}" />
                                        <ComboBox x:Name="ModeCombo" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="ModeCombo_SelectionChanged">
                                            <ComboBoxItem Content="{StaticResource Counter}" />
                                            <ComboBoxItem Content="{StaticResource SineWave}" />
                                            <ComboBoxItem Content="{StaticResource Random}" />
                                            <ComboBoxItem Content="{StaticResource FixedText}" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <TextBlock Text="{StaticResource Interval}" />
                                        <TextBox x:Name="IntervalBox" Text="1000" InputScope="Number" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="5">
                                    <TextBlock x:Name="TemplateLabel" Text="{StaticResource MessageFormat}" />
                                    <TextBox
                                        x:Name="TemplateBox"
                                        Text="{}{timestamp},{counter},{value}"
                                        PlaceholderText="{StaticResource EnterMessageFormat}"
                                        AcceptsReturn="True"
                                        Height="72"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="TemplateHint"
                                        Text="{StaticResource TemplateHelp}"
                                        TextWrapping="Wrap"
                                        Opacity="0.7"
                                        FontSize="12" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{StaticResource LineEnding}" VerticalAlignment="Center" />
                                    <ComboBox x:Name="LineEndingCombo" Width="145" SelectedIndex="1">
                                        <ComboBoxItem Content="{StaticResource None}" />
                                        <ComboBoxItem Content="CRLF (\r\n)" />
                                        <ComboBoxItem Content="LF (\n)" />
                                        <ComboBoxItem Content="CR (\r)" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="StartButton" Content="{StaticResource StartSending}" Click="StartButton_Click" IsEnabled="False" />
                                    <Button x:Name="StopButton" Content="{StaticResource Stop}" Click="StopButton_Click" IsEnabled="False" />
                                    <Button x:Name="SendOnceButton" Content="{StaticResource SendOnce}" Click="SendOnceButton_Click" IsEnabled="False" />
                                    <Button x:Name="ResetButton" Content="{StaticResource ResetCount}" Click="ResetButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#66808080" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{StaticResource ReplyRules}" FontSize="18" FontWeight="SemiBold" />
                                <TextBox
                                    x:Name="RuleBox"
                                    Text="PING=PONG"
                                    AcceptsReturn="True"
                                    TextWrapping="NoWrap"
                                    Height="92"
                                    FontFamily="Consolas"
                                    PlaceholderText="{StaticResource ReplyRuleHint}" />
                                <TextBlock
                                    Text="{StaticResource ReplyRuleHelp}"
                                    Opacity="0.7"
                                    FontSize="12"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border
                            controls:FlowPanel.Span="2"
                            BorderBrush="#66808080"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <TextBlock Text="{StaticResource Traffic}" FontSize="18" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                        <CheckBox x:Name="ShowLogTimestampCheck"
                                                  Content="{StaticResource ShowTime}"
                                                  IsChecked="True"
                                                  Checked="ShowLogTimestampCheck_Changed"
                                                  Unchecked="ShowLogTimestampCheck_Changed" />
                                        <Button Content="{StaticResource ClearLog}" Click="ClearButton_Click" />
                                    </StackPanel>
                                </Grid>
                                <TextBox
                                    x:Name="LogBox"
                                    IsReadOnly="True"
                                    AcceptsReturn="True"
                                    TextWrapping="NoWrap"
                                    Height="180"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    FontFamily="Consolas" />
                            </StackPanel>
                        </Border>
                    </controls:FlowPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>

        <Border
            Grid.Row="2"
            Margin="24,0,24,16"
            Padding="12,8"
            BorderBrush="#66808080"
            BorderThickness="1"
            CornerRadius="6">
            <TextBlock x:Name="StatusText" Text="{StaticResource Disconnected}" Opacity="0.8" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
