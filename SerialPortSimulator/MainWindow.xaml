<Window
    x:Class="SerialPortSimulator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SerialPortSimulator.Controls"
    Title="串口设备模拟器">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,18,24,10" Spacing="3">
            <TextBlock Text="串口设备模拟器" FontSize="27" FontWeight="SemiBold" />
            <TextBlock
                Text="模拟器定义串口参数，业务端通过 COM 口连接并按设备参数适配"
                Opacity="0.7" />
        </StackPanel>

        <TabView
            Grid.Row="1"
            Margin="18,0,18,10"
            IsAddTabButtonVisible="False"
            TabWidthMode="Equal">
            <TabViewItem Header="虚拟设备" IsClosable="False">
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Center">
                    <controls:FlowPanel
                        Margin="4,14,4,20"
                        MaxWidth="980"
                        HorizontalAlignment="Center"
                        MinimumItemWidth="360"
                        HorizontalSpacing="16"
                        VerticalSpacing="16">
                        <Border
                            controls:FlowPanel.Span="2"
                            BorderBrush="#66808080"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                            <StackPanel Spacing="14">
                                <TextBlock Text="设备连接" FontSize="18" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        x:Name="DeviceCombo"
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        PlaceholderText="选择本产品的虚拟串口"
                                        SelectionChanged="DeviceCombo_SelectionChanged" />
                                    <Button
                                        x:Name="RefreshButton"
                                        Grid.Column="1"
                                        Content="刷新设备"
                                        Click="RefreshButton_Click" />
                                    <Button
                                        x:Name="ConnectButton"
                                        Grid.Column="2"
                                        Content="打开控制通道"
                                        Click="ConnectButton_Click" />
                                </Grid>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="业务端口" Opacity="0.7" FontSize="12" />
                                        <TextBlock x:Name="PortText" Text="未选择" FontFamily="Consolas" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="设备实例" Opacity="0.7" FontSize="12" />
                                        <TextBlock
                                            x:Name="DeviceIdText"
                                            Text="未选择"
                                            FontFamily="Consolas"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="3">
                                        <TextBlock Text="控制协议" Opacity="0.7" FontSize="12" />
                                        <TextBlock x:Name="ProtocolText" Text="未读取" FontFamily="Consolas" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    Text="模拟器只占用独立控制接口；业务程序独占打开设备列表中显示的 COM 端口。"
                                    Opacity="0.7"
                                    FontSize="12"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#66808080" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Text="模拟串口参数" FontSize="18" FontWeight="SemiBold" />
                                <StackPanel x:Name="SerialParameterPanel" Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="波特率" />
                                            <ComboBox
                                                x:Name="BaudRateCombo"
                                                IsEditable="True"
                                                HorizontalAlignment="Stretch"
                                                SelectedIndex="3">
                                                <x:String>1200</x:String>
                                                <x:String>2400</x:String>
                                                <x:String>4800</x:String>
                                                <x:String>9600</x:String>
                                                <x:String>19200</x:String>
                                                <x:String>38400</x:String>
                                                <x:String>57600</x:String>
                                                <x:String>115200</x:String>
                                                <x:String>230400</x:String>
                                                <x:String>460800</x:String>
                                                <x:String>921600</x:String>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <TextBlock Text="数据位" />
                                            <ComboBox x:Name="DataBitsCombo" HorizontalAlignment="Stretch" SelectedIndex="3">
                                                <x:String>5</x:String>
                                                <x:String>6</x:String>
                                                <x:String>7</x:String>
                                                <x:String>8</x:String>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="5">
                                            <TextBlock Text="校验位" />
                                            <ComboBox x:Name="ParityCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                                                <x:String>无</x:String>
                                                <x:String>奇校验</x:String>
                                                <x:String>偶校验</x:String>
                                                <x:String>Mark</x:String>
                                                <x:String>Space</x:String>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Spacing="5">
                                            <TextBlock Text="停止位" />
                                            <ComboBox x:Name="StopBitsCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                                                <x:String>1</x:String>
                                                <x:String>1.5</x:String>
                                                <x:String>2</x:String>
                                            </ComboBox>
                                        </StackPanel>
                                        <Button
                                            x:Name="ApplySerialParametersButton"
                                            Grid.Column="4"
                                            Content="应用参数"
                                            Click="ApplySerialParametersButton_Click"
                                            VerticalAlignment="Bottom" />
                                    </Grid>
                                    <CheckBox x:Name="LimitToBaudRateCheck"
                                              Content="按波特率限制双向传输速度"
                                              IsEnabled="False" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <CheckBox x:Name="CtsOnCheck" Content="CTS 允许业务端发送" IsEnabled="False" />
                                        <Button x:Name="ApplyCtsButton" Content="应用 CTS" Click="ApplyCtsButton_Click" IsEnabled="False" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="BusinessLineText"
                                        Text="业务控制线：打开控制通道后读取"
                                        Opacity="0.7"
                                        FontSize="12"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="SerialParameterStatusText"
                                        Text="选择设备后可读取并设置模拟串口参数。"
                                        Opacity="0.7"
                                        FontSize="12"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#66808080" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock Text="设备管理" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="新建、更新和删除操作需要管理员权限；驱动资源已内嵌在管理员程序中。"
                                    Opacity="0.7"
                                    FontSize="12"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button
                                        x:Name="CreateDeviceButton"
                                        Content="新建设备"
                                        Click="CreateDeviceButton_Click" />
                                    <Button
                                        x:Name="UpdateDriverButton"
                                        Content="更新驱动"
                                        Click="UpdateDriverButton_Click" />
                                    <Button
                                        x:Name="RemoveDeviceButton"
                                        Content="删除选中设备"
                                        Click="RemoveDeviceButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </controls:FlowPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="模拟与收发" IsClosable="False">
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Center">
                    <controls:FlowPanel
                        Margin="4,14,4,20"
                        MaxWidth="980"
                        HorizontalAlignment="Center"
                        MinimumItemWidth="360"
                        HorizontalSpacing="16"
                        VerticalSpacing="16">
                        <Border BorderBrush="#66808080" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <TextBlock Text="模拟数据" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="InjectionTargetText"
                                        Text="注入目标：未连接"
                                        HorizontalAlignment="Right"
                                        Opacity="0.7"
                                        FontFamily="Consolas" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="数据模式" />
                                        <ComboBox x:Name="ModeCombo" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="ModeCombo_SelectionChanged">
                                            <x:String>递增计数</x:String>
                                            <x:String>正弦波</x:String>
                                            <x:String>随机值</x:String>
                                            <x:String>固定文本</x:String>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <TextBlock Text="发送间隔（毫秒）" />
                                        <TextBox x:Name="IntervalBox" Text="1000" InputScope="Number" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="5">
                                    <TextBlock x:Name="TemplateLabel" Text="消息模板" />
                                    <TextBox
                                        x:Name="TemplateBox"
                                        Text="{}{timestamp},{counter},{value}"
                                        PlaceholderText="输入消息模板或固定文本"
                                        AcceptsReturn="True"
                                        Height="72"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="TemplateHint"
                                        Text="支持 {timestamp}、{counter}、{value}；数据按 UTF-8 注入。"
                                        Opacity="0.7"
                                        FontSize="12" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="数据末尾" VerticalAlignment="Center" />
                                    <ComboBox x:Name="LineEndingCombo" Width="145" SelectedIndex="1">
                                        <ComboBoxItem Content="无" />
                                        <ComboBoxItem Content="CRLF (\r\n)" />
                                        <ComboBoxItem Content="LF (\n)" />
                                        <ComboBoxItem Content="CR (\r)" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="StartButton" Content="开始周期注入" Click="StartButton_Click" IsEnabled="False" />
                                    <Button x:Name="StopButton" Content="停止注入" Click="StopButton_Click" IsEnabled="False" />
                                    <Button x:Name="SendOnceButton" Content="注入一次" Click="SendOnceButton_Click" IsEnabled="False" />
                                    <Button x:Name="ResetButton" Content="重置计数" Click="ResetButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#66808080" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock Text="请求响应规则" FontSize="18" FontWeight="SemiBold" />
                                <TextBox
                                    x:Name="RuleBox"
                                    Text="PING=PONG"
                                    AcceptsReturn="True"
                                    TextWrapping="NoWrap"
                                    Height="92"
                                    FontFamily="Consolas"
                                    PlaceholderText="每行一条：请求=响应" />
                                <TextBlock
                                    Text="业务端每行请求以 CRLF 结尾才触发匹配；响应末尾自动添加 CRLF。支持 \r、\n 转义。"
                                    Opacity="0.7"
                                    FontSize="12"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border
                            controls:FlowPanel.Span="2"
                            BorderBrush="#66808080"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <TextBlock Text="收发数据" FontSize="18" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                        <CheckBox x:Name="ShowLogTimestampCheck"
                                                  Content="显示时间戳"
                                                  IsChecked="True"
                                                  Checked="ShowLogTimestampCheck_Changed"
                                                  Unchecked="ShowLogTimestampCheck_Changed" />
                                        <Button Content="清空记录" Click="ClearButton_Click" />
                                    </StackPanel>
                                </Grid>
                                <TextBox
                                    x:Name="LogBox"
                                    IsReadOnly="True"
                                    AcceptsReturn="True"
                                    TextWrapping="NoWrap"
                                    Height="180"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    FontFamily="Consolas" />
                            </StackPanel>
                        </Border>
                    </controls:FlowPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>

        <Border
            Grid.Row="2"
            Margin="24,0,24,16"
            Padding="12,8"
            BorderBrush="#66808080"
            BorderThickness="1"
            CornerRadius="6">
            <TextBlock x:Name="StatusText" Text="未连接" Opacity="0.8" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
