<UserControl
    x:Class="SerialPortSimulator.Controls.DeviceTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SerialPortSimulator.Controls"
    xmlns:ui="using:SerialPortSimulator.Services">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalContentAlignment="Center">
        <controls:FlowPanel
            Margin="4,14,4,20"
            MaxWidth="980"
            HorizontalAlignment="Center"
            MinimumItemWidth="360"
            HorizontalSpacing="16"
            VerticalSpacing="16">

            <Border BorderBrush="#66808080" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock
                            ui:UiText.Key="PortSettings"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold" />
                        <Button
                            x:Name="ConnectButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="ConnectButton_Click" />
                    </Grid>
                    <StackPanel x:Name="SerialParameterPanel" Spacing="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="0.8*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock ui:UiText.Key="BaudRate" />
                                <ComboBox
                                    x:Name="BaudRateCombo"
                                    IsEditable="True"
                                    HorizontalAlignment="Stretch"
                                    SelectedIndex="3"
                                    SelectionChanged="SerialConfigControl_Changed"
                                    TextSubmitted="BaudRateCombo_TextSubmitted"
                                    LostFocus="SerialConfigControl_Changed">
                                    <x:String>1200</x:String>
                                    <x:String>2400</x:String>
                                    <x:String>4800</x:String>
                                    <x:String>9600</x:String>
                                    <x:String>19200</x:String>
                                    <x:String>38400</x:String>
                                    <x:String>57600</x:String>
                                    <x:String>115200</x:String>
                                    <x:String>230400</x:String>
                                    <x:String>460800</x:String>
                                    <x:String>921600</x:String>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock ui:UiText.Key="DataBits" />
                                <ComboBox
                                    x:Name="DataBitsCombo"
                                    HorizontalAlignment="Stretch"
                                    SelectedIndex="3"
                                    SelectionChanged="SerialConfigControl_Changed">
                                    <x:String>5</x:String>
                                    <x:String>6</x:String>
                                    <x:String>7</x:String>
                                    <x:String>8</x:String>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="5">
                                <TextBlock ui:UiText.Key="Parity" />
                                <ComboBox
                                    x:Name="ParityCombo"
                                    HorizontalAlignment="Stretch"
                                    SelectedIndex="0"
                                    SelectionChanged="SerialConfigControl_Changed">
                                    <ComboBoxItem ui:UiText.Key="None" />
                                    <ComboBoxItem ui:UiText.Key="Odd" />
                                    <ComboBoxItem ui:UiText.Key="Even" />
                                    <ComboBoxItem Content="Mark" />
                                    <ComboBoxItem Content="Space" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="5">
                                <TextBlock ui:UiText.Key="StopBits" />
                                <ComboBox
                                    x:Name="StopBitsCombo"
                                    HorizontalAlignment="Stretch"
                                    SelectedIndex="0"
                                    SelectionChanged="SerialConfigControl_Changed">
                                    <x:String>1</x:String>
                                    <x:String>1.5</x:String>
                                    <x:String>2</x:String>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <CheckBox
                            x:Name="LimitToBaudRateCheck"
                            ui:UiText.Key="LimitBaudRate"
                            IsEnabled="False"
                            Checked="SerialConfigControl_Changed"
                            Unchecked="SerialConfigControl_Changed" />
                        <CheckBox
                            x:Name="CtsOnCheck"
                            ui:UiText.Key="AllowCts"
                            IsEnabled="False"
                            Checked="CtsOnCheck_Changed"
                            Unchecked="CtsOnCheck_Changed" />
                        <TextBlock
                            x:Name="BusinessLineText"
                            Opacity="0.7"
                            FontSize="12"
                            TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="SerialParameterStatusText"
                                VerticalAlignment="Center"
                                Opacity="0.7"
                                FontSize="12"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="UpdateDriverButton"
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Visibility="Collapsed"
                                ui:UiText.Key="UpdateDriver"
                                Click="UpdateDriverButton_Click" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border BorderBrush="#66808080" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock
                            ui:UiText.Key="SimulatedData"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="InjectionTargetText"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Opacity="0.7"
                            FontFamily="Consolas" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock ui:UiText.Key="DataType" />
                            <ComboBox
                                x:Name="ModeCombo"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0"
                                SelectionChanged="ModeCombo_SelectionChanged">
                                <ComboBoxItem ui:UiText.Key="Counter" />
                                <ComboBoxItem ui:UiText.Key="SineWave" />
                                <ComboBoxItem ui:UiText.Key="Random" />
                                <ComboBoxItem ui:UiText.Key="FixedText" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock ui:UiText.Key="Interval" />
                            <TextBox x:Name="IntervalBox" Text="1000" InputScope="Number" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="5">
                        <TextBlock x:Name="TemplateLabel" />
                        <TextBox
                            x:Name="TemplateBox"
                            Text="{}{timestamp},{counter},{value}"
                            ui:UiText.Key="EnterMessageFormat"
                            AcceptsReturn="True"
                            Height="72"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="TemplateHint"
                            ui:UiText.Key="TemplateHelp"
                            TextWrapping="Wrap"
                            Opacity="0.7"
                            FontSize="12" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock ui:UiText.Key="LineEnding" VerticalAlignment="Center" />
                        <ComboBox x:Name="LineEndingCombo" Width="145" SelectedIndex="1">
                            <ComboBoxItem ui:UiText.Key="None" />
                            <ComboBoxItem Content="CRLF (\r\n)" />
                            <ComboBoxItem Content="LF (\n)" />
                            <ComboBoxItem Content="CR (\r)" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="StartButton" ui:UiText.Key="StartSending" Click="StartButton_Click" IsEnabled="False" />
                        <Button x:Name="StopButton" ui:UiText.Key="Stop" Click="StopButton_Click" IsEnabled="False" />
                        <Button x:Name="SendOnceButton" ui:UiText.Key="SendOnce" Click="SendOnceButton_Click" IsEnabled="False" />
                        <Button x:Name="ResetButton" ui:UiText.Key="ResetCount" Click="ResetButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border BorderBrush="#66808080" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock ui:UiText.Key="ReplyRules" FontSize="18" FontWeight="SemiBold" />
                    <TextBox
                        x:Name="RuleBox"
                        Text="PING=PONG"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        Height="92"
                        FontFamily="Consolas"
                        TextChanged="RuleBox_TextChanged"
                        ui:UiText.Key="ReplyRuleHint" />
                    <TextBlock
                        ui:UiText.Key="ReplyRuleHelp"
                        Opacity="0.7"
                        FontSize="12"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border BorderBrush="#66808080" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock ui:UiText.Key="Traffic" FontSize="18" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                            <CheckBox
                                x:Name="ShowLogTimestampCheck"
                                ui:UiText.Key="ShowTime"
                                IsChecked="True"
                                Checked="ShowLogTimestampCheck_Changed"
                                Unchecked="ShowLogTimestampCheck_Changed" />
                            <Button ui:UiText.Key="ClearLog" Click="ClearButton_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBox
                        x:Name="LogBox"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        Height="180"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        FontFamily="Consolas" />
                </StackPanel>
            </Border>
        </controls:FlowPanel>
    </ScrollViewer>
</UserControl>
